{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:gtfs": "node scripts/build-gtfs.mjs",
    "fetch:gtfs": "tsx --env-file-if-exists=.env scripts/fetch-gtfs.ts",
    "data:refresh": "npm run fetch:gtfs && npm run build:gtfs",
    "predev": "npm run data:refresh",
    "prebuild": "npm run data:refresh"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "maplibre-gl": "^6.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-map-gl": "^8.1.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "papaparse": "^5.7.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "unzipper": "^0.12.5",
    "vite": "^8.2.2"
  }
}
